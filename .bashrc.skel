#!/usr/bin/env bash
#
#=-----------------------------------------------------------------------------
#
# ~/.bashrc
#
# to use, either copy this file into your home dir as ~/.bashrc, or paste its
# contents at the bottom of an existing ~/.bashrc
#
# below we just:
#
# - source the og `.bashrc` file from the specified dotfiles directory
# - export env vars for use in shell or by other scripts
#
#=-----------------------------------------------------------------------------
#`

jconf=~/.config/"$(whoami)"
jconf_dotfiles="$jconf/dotfiles"
jconf_bashrc="$jconf_dotfiles/.bashrc"

if [ -f "$jconf_bashrc" ]; then
    [[ "$DEBUG" ]] && echo "[SUCCESS] found $jconf_bashrc"
    . "$jconf_bashrc"
    export JCONF="$jconf"
    export JCONF_DOTFILES="$jconf_dotfiles"
else
    echo "[FAIL] can't find $jconf_bashrc"
fi

# shellcheck disable=SC1091
# source uv env file early
. "$HOME/.local/bin/env"
