#!/usr/bin/env bash
#
# Get and display weather from `wttr.in` from cli
#
# Note: If you source this file, it will set WTTR_PARAMS and show the weather.
#
#=-----------------------------------------------------------------------------
#`

# WTTR_PARAMS is space-separated URL parameters,
# many of which are single characters that can be lumped together,
# e.g. "F q m" behaves the same as "Fqm".
#
if [[ -z "$WTTR_PARAMS" ]]; then

    # form localized URL parameters for curl
    #
    if [[ -t 1 ]] && [[ "$(tput cols)" -lt 125 ]]; then
        WTTR_PARAMS+='n'
    fi 2> /dev/null
    for _token in $( locale LC_MEASUREMENT ); do
        case $_token in
            1) WTTR_PARAMS+='m' ;;
            2) WTTR_PARAMS+='u' ;;
        esac
    done 2> /dev/null
    unset _token
    export WTTR_PARAMS

    # debug
    #
    [[ "$DEBUG" ]] && echo "WTTR_PARAMS -=> $WTTR_PARAMS"
fi

# Create fonktion for running curl against `wttr.in`
#
# Allows for display of weather in different ways
#
# https://github.com/chubin/wttr.in
#
wttr() {
  local location="${1// /+}"
  command shift
  local args=""

  # combine args with WTTR_PARAMS
  #
  for p in $WTTR_PARAMS "$@"; do
    args+=" --data-urlencode $p "
  done

  # print debug before running command
  #
  if [[ "$DEBUG" ]]; then
      echo "wttr args -=> $args"
      echo "wttr location -=> $location"
  fi

  # curl options used
  #
  # -f --fail
  # Fail fast with no output at all on server errors
  #
  # -G --get
  # Force GET request for all data specified with -d, --data, --data-binary or --data-urlencode
  #
  # -s --silent
  # Do not show progress meter or error messages
  #
  # -S --show-error,
  # When used with -s, --silent, it makes curl show an error message if it fails
  #
  #
  # build curl command
  #
  curl -fGsS --compressed \
       -H "Accept-Language: ${LANG%_*}" $args "https://wttr.in/${location}"
}

# run da fonktion
#
wttr "$@"
