#._____________________________________________________________________________
#`

#.
# Cursor
#
# https://ghostty.org/docs/config/reference#cursor-style
# https://ghostty.org/docs/config/reference#cursor-style-blink
# https://ghostty.org/docs/config/reference#cursor-color
#
# (note the animated cursor is actually the custom-shader; see Shaders section)
#
cursor-style = block
cursor-style-blink = false
cursor-color = #ffb929

#.
# Shell Integration
#
# https://ghostty.org/docs/config/reference#shell-integration
# https://ghostty.org/docs/config/reference#shell-integration-features
#
shell-integration = detect
shell-integration-features = no-cursor

#.
# Fonts
#
# https://ghostty.org/docs/config/reference#font-family
# https://ghostty.org/docs/config/reference#font-size
#
font-family = Lilex Nerd Font Mono Regular
font-size = 18

#.
# Background
#
# https://ghostty.org/docs/config/reference#background-opacity
# https://ghostty.org/docs/config/reference#background-blur
#
background-opacity = 0.90
background-blur = 16

#.
# Theme + colors
#
# `ghostty +list-themes`
#
# https://ghostty.org/docs/config/reference#theme
#
theme = Popping and Locking

#.
# Clipboard
#
# https://ghostty.org/docs/config/reference#copy-on-select
#
copy-on-select = clipboard

#.
# Shaders
#
# https://ghostty.org/docs/config/reference#custom-shader
#
# (see cursor and shader notes in comments at top of this file)
#
custom-shader = shaders/cursors/blaze.glsl
